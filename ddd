local player = game.Players.LocalPlayer
local remoteEvent = game:GetService("ReplicatedStorage"):FindFirstChild("SaveTraits")

local function interceptSave()
    if remoteEvent then
        local oldFunction = remoteEvent.OnClientEvent
        remoteEvent.OnClientEvent = function(data)
            if data and data.traits then
                return
            end
            oldFunction(data)
        end
    end
end

interceptSave()
